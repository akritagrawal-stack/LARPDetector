# Free, no-key web search for local development. It is less stable than a
# private SearXNG instance, but requires no Docker or account.
DDGS_ENABLED=1
DDGS_BACKEND=bing,yahoo,duckduckgo

# Execute one public web product page in bundled headless Chromium. This
# verifies rendered/app surfaces without submitting forms or credentials.
WEB_RUNTIME_ENABLED=1

# Deep-inspect up to two public repositories for a confirmed GitHub identity.
# Without GitHub auth the connector enforces a one-repository ceiling. On
# macOS it can reuse GitHub CLI auth from Keychain, so no token belongs here.
GITHUB_DEEP_ENABLED=1
GITHUB_DEEP_MAX_REPOS=2

# Always use the hardened aggregate dossier engine.
LARP_ENGINE=dossier

# Manual queue jobs are the only path that uses the existing Codex/ChatGPT
# subscription without a separate metered model API.
LARP_SERVICE_PROVIDER=manual

# Paid or authenticated sources stay off unless explicitly enabled.
PITCHBOOK_ENABLED=0

# Optional alternatives:
# SEARXNG_URL=http://127.0.0.1:8080
# TAVILY_API_KEY=
# EXA_API_KEY=
# BRAVE_API_KEY=
# GITHUB_TOKEN=  # optional CI/headless alternative to GitHub CLI auth
# GEMINI_API_KEY=
